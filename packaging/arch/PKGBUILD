# Builds the package from the local git checkout this PKGBUILD lives in.
# Only committed changes are packaged.
pkgname=w3-quest-tracker-git
_name=w3-quest-tracker
pkgver=r22.g111fb4d
pkgrel=1
pkgdesc="Quest tracker for The Witcher 3 that follows your newest save file"
arch=('any')
license=('unknown')
depends=('python' 'pyside6' 'python-watchdog')
optdepends=('python-lz4: faster save decompression')
makedepends=('git')
provides=("$_name")
conflicts=("$_name")
source=("$_name::git+file://$(realpath "$startdir/../..")")
sha256sums=('SKIP')

pkgver() {
  cd "$_name"
  printf "r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

check() {
  cd "$_name"
  QT_QPA_PLATFORM=offscreen python -m unittest discover -s tests
}

package() {
  cd "$_name"
  local site
  site=$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
  install -d "$pkgdir$site"
  cp -r src/w3qt "$pkgdir$site/"
  find "$pkgdir$site/w3qt" -name __pycache__ -prune -exec rm -rf {} +
  python -m compileall -q -s "$pkgdir" "$pkgdir$site/w3qt"

  install -Dm755 packaging/bin/w3-quest-tracker -t "$pkgdir/usr/bin/"
  install -Dm755 packaging/bin/w3-quest-tracker-build-quests -t "$pkgdir/usr/bin/"
  install -Dm644 packaging/w3-quest-tracker.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 src/w3qt/data/w3-quest-tracker.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 README.md docs/*.md -t "$pkgdir/usr/share/doc/$_name/"
  install -Dm644 src/w3qt/data/fonts/OFL-*.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
